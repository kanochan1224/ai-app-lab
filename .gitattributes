# 统一行尾：仓库内一律 LF，避免 Windows/Linux 协作出现整文件 diff
* text=auto eol=lf

# Windows 批处理必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pt binary
*.bin binary
*.safetensors binary
*.onnx binary

# 语言统计口径
*.jsonl linguist-language=JSON
rag/data/raw/** linguist-documentation
agent/web/index.html linguist-detectable=true
