# ============================ 决策后端 ============================
# openai：任意 OpenAI 兼容端点，支持 function calling（推荐）
# mock  ：离线脚本化策略，仅用于无 Key 演示与测试，**不做真实决策**
BRAIN_BACKEND=openai

# DeepSeek（默认）
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=

# 硅基流动（注册送额度，OpenAI 兼容）
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxx

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=90
# auto 由模型决定是否调工具；required 强制本轮必须调用（首轮更稳）
TOOL_CHOICE=auto

# ============================ 防护参数 ============================
# Agent 失控基本都源于这几个值没设好
MAX_STEPS=12
MAX_SECONDS=180
# 同一工具同一参数重复几次后注入提醒
REPEAT_TOLERANCE=2
# 单次工具结果注入上下文的字符上限（防止一次抓取撑爆窗口）
MAX_OBSERVATION_CHARS=4000
# 工具连续失败多少次后强制要求作答
MAX_CONSECUTIVE_FAILURES=4

# ============================ 工具开关 ============================
ENABLE_COURSE_KB=true
ENABLE_WEB_SEARCH=true
ENABLE_CODE_EXEC=true

SEARCH_MAX_RESULTS=5
FETCH_MAX_CHARS=6000
HTTP_TIMEOUT=15
CODE_TIMEOUT=10

# ============================ 跨项目复用 ============================
# rag 项目根目录：search_course_kb 工具直接复用它的混合检索+重排
# 留空则默认取同级的 ../rag（单仓库结构）
COURSE_RAG_PATH=
