# 统一行尾：文本文件在仓库内一律用 LF，避免 Windows/Linux 协作时出现整文件 diff
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pt binary
*.bin binary
*.safetensors binary
*.onnx binary

# 这些文件不需要参与语言统计
*.jsonl linguist-language=JSON
data/raw/** linguist-documentation
