# CourseRAG 配置模板：复制为 .env 后填入自己的密钥
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)

# ============================ 知识库标识 ============================
KB_NAME=《机器学习导论》课程知识库

# ============================ 文本切分 ============================
# fixed（定长滑窗）/ recursive（结构化递归，推荐）/ semantic（语义断点）
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SEMANTIC_THRESHOLD=0.62

# ============================ 向量化后端 ============================
# local       本地 sentence-transformers（需 pip install -r requirements-ml.txt，无需 Key）
# siliconflow 硅基流动，OpenAI 兼容
# dashscope   阿里云百炼（通义），OpenAI 兼容
# openai      OpenAI 官方或任意兼容端点
# hash        哈希伪向量，仅用于无网环境跑通流程与单元测试
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=512
# BGE 中文系列建议给「查询」加指令前缀，召回更好
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 用云端向量化时填这两项，例如：
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_MODEL=BAAI/bge-m3

# 国内下载 HuggingFace 模型的镜像（默认已指向 hf-mirror）
HF_ENDPOINT=https://hf-mirror.com

# ============================ 重排 ============================
# local 用 cross-encoder（需 requirements-ml.txt）；api 用云端 rerank 接口
RERANK_ENABLED=true
RERANK_PROVIDER=local
RERANK_MODEL=maidalun1020/bce-reranker-base_v1
RERANK_TOP_N=5
# 融合后先截断到这么多候选再送重排，控制延迟（CPU 上这是主要成本）
RERANK_CANDIDATE_POOL=10
# 送进模型的文本上限：算分主要看片段开头，截断能大幅降低 CPU 耗时
# （实测 20 对 × 492 字需 3.6s，截到 320 字约 1s）
RERANK_MAX_CHARS=320
RERANK_BATCH_SIZE=8
# 模型已缓存时自动强制离线加载，避免每次启动都去 huggingface.co 查版本
HF_HUB_OFFLINE=1

# ============================ 检索 ============================
ENABLE_HYBRID=true
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSED_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0

# ============================ 大模型（生成） ============================
# 不填 LLM_API_KEY 时自动降级为「抽取式回答」，链路仍可完整演示
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
# 也可以换成硅基流动（有免费额度）：
# LLM_PROVIDER=siliconflow
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_API_KEY=sk-xxxxxxxx

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=60
ALLOW_EXTRACTIVE_FALLBACK=true
STRICT_CITATION=true

# 证据不足时的拒答阈值。留空表示不启用阈值拒答（只依赖模型判断）
# 若启用了重排，建议先用 scripts/calibrate.py 观察 rerank 分数分布再设定
REFUSAL_SCORE_THRESHOLD=

# ============================ 索引 ============================
INDEX_COLLECTION=course_kb
